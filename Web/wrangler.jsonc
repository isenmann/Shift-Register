{
  "name": "shift-register-levels",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Files here are served as they are; everything else (/api/levels) reaches the Worker.
  "assets": { "directory": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shift-register-levels",
      "database_id": "REPLACE_WITH_THE_ID_FROM_D1_CREATE"
    }
  ],
  // Uploads per visitor. Periods can only be 10 or 60 seconds.
  "ratelimits": [
    { "name": "UPLOADS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
