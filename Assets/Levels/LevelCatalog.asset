  m_Name: LevelCatalog
  m_EditorClassIdentifier: ShiftRegister.Game::ShiftRegister.Game.LevelCatalog
  chapters:
  - name: Basics
    description: Row and column shifts, and the edge that eats bits.
    levels:
    - {fileID: 4900000, guid: 5421b8601ea51283a860c78304169bed, type: 3}
  - name: Numbers
    description: Rows become numbers. Left doubles, right halves.
    levels:
    - {fileID: 4900000, guid: bff1d4d0bd38878649501c54764a60b4, type: 3}
  - name: Walls & Pins
    description: Walls split rows into parts, pins lock a row and column.
    levels: []
  - name: Rotate
    description: Some rows wrap around instead of dropping bits.
    levels: []
  - name: Carry
    description: Chained rows carry overflow into the next row.
    levels: []
  - name: Logic
    description: 'Masks combine with a row after every move: AND keeps, OR sets, XOR toggles.'
    levels:
